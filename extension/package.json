{
  "name": "kyn-language",
  "displayName": "Kyn Language Support",
  "description": "Compiler-resolved navigation, diagnostics and language tooling for the Kyn programming language.",
  "version": "0.4.0",
  "publisher": "ceomatheusdev",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "kyn",
    "language",
    "compiler",
    "diagnostics",
    "llvm",
    "assembly",
    "go-to-definition",
    "references",
    "workspace-symbols",
    "semantic-navigation",
    "compiler-index"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:kyn",
    "workspaceContains:*.kyn"
  ],
  "scripts": {
    "check": "node --check src/extension.js && node --check src/index.js",
    "package": "vsce package",
    "test": "node --test"
  },
  "contributes": {
    "languages": [
      {
        "id": "kyn",
        "aliases": [
          "Kyn",
          "kyn"
        ],
        "extensions": [
          ".kyn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kyn",
        "scopeName": "source.kyn",
        "path": "./syntaxes/kyn.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kyn",
        "path": "./snippets/kyn.json"
      }
    ],
    "configuration": {
      "title": "Kyn",
      "properties": {
        "kyn.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to kync. Empty auto-detects zig-out/bin/kync, then searches PATH."
        },
        "kyn.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run kync check when a Kyn file is saved."
        },
        "kyn.checkOnType": {
          "type": "boolean",
          "default": true,
          "description": "Run kync check after edits."
        },
        "kyn.checkDebounce": {
          "type": "number",
          "default": 450,
          "minimum": 100,
          "maximum": 5000,
          "description": "Edit debounce in milliseconds."
        }
      }
    },
    "commands": [
      {
        "command": "kyn.checkCurrentFile",
        "title": "Kyn: Check Current File"
      },
      {
        "command": "kyn.emitLLVM",
        "title": "Kyn: Emit LLVM IR"
      },
      {
        "command": "kyn.emitAssembly",
        "title": "Kyn: Emit x86-64 Assembly"
      },
      {
        "command": "kyn.checkWorkspace",
        "title": "Kyn: Check Open Kyn Files"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kyn.checkCurrentFile",
          "when": "resourceLangId == kyn",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "kyn.checkCurrentFile",
          "when": "resourceLangId == kyn",
          "group": "navigation"
        },
        {
          "command": "kyn.emitLLVM",
          "when": "resourceLangId == kyn",
          "group": "navigation@2"
        },
        {
          "command": "kyn.emitAssembly",
          "when": "resourceLangId == kyn",
          "group": "navigation@3"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CeoMatheusDev/Kyn"
  }
}
