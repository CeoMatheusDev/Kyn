{
  "Function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2}) -> ${3:i32} {", "    ${0}", "}"],
    "description": "Declare a Kyn function"
  },
  "Main function": {
    "prefix": "main",
    "body": ["fn main() -> i32 {", "    ${0:return 0;}", "}"],
    "description": "Kyn program entry point"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "    ${2:field}: ${3:i32},", "}"],
    "description": "Declare a Kyn struct"
  },
  "Enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "    ${2:First},", "    ${3:Second},", "}"],
    "description": "Declare a Kyn enum"
  },
  "Implementation": {
    "prefix": "impl",
    "body": ["impl ${1:Type} {", "    fn ${2:name}(self: ${1:Type}) -> ${3:i32} {", "        ${0}", "    }", "}"],
    "description": "Declare methods for a struct or enum"
  },
  "Import": {
    "prefix": "import",
    "body": ["import \"${1:module.kyn}\";"],
    "description": "Import another Kyn source file"
  },
  "If / else": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "    ${2}", "} else {", "    ${0}", "}"],
    "description": "Conditional branch"
  },
  "While loop": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "    ${0}", "}"],
    "description": "While loop"
  },
  "Switch": {
    "prefix": "switch",
    "body": ["switch ${1:value} {", "    ${2:Variant} => {", "        ${0}", "    },", "    else => {", "    },", "}"],
    "description": "Exhaustive enum switch"
  },
  "Print string": {
    "prefix": "print",
    "body": ["print(${1:\"text\"});"],
    "description": "Print a string followed by a newline"
  },
  "Print integer": {
    "prefix": "printi",
    "body": ["print_i32(${1:value});"],
    "description": "Print an i32 followed by a newline"
  }
}
