// Struct by value crosses modules: identity and field order preserved.
// expect-stdout: 13
// expect-stdout: 13
// expect-exit: 13
import "point.kyn";

fn sum(p: Point) -> i32 {
    return p.x + p.y;
}

fn main() -> i32 {
    let a = origin();
    print_i32(sum(a));
    let b = mirror(a);
    print_i32(sum(b));
    return sum(b);
}
