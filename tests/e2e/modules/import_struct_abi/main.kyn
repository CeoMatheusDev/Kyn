import "ponto.kyn";

fn soma(p: Ponto) -> i32 {
    return p.x + p.y;
}

fn main() -> i32 {
    let a = origem();
    print_i32(soma(a));
    let b = espelha(a);
    print_i32(soma(b));
    return soma(b);
}
