// Struct field in a 'while' and in an 'if' condition.
// expect-exit: 10
struct Counter {
    value: i32,
    active: bool,
}

fn main() -> i32 {
    var c: Counter = Counter { value: 0, active: true };
    while c.value < 10 {
        c.value = c.value + 2;
    }
    if c.active && c.value == 10 {
        return c.value;
    }
    return 1;
}
