// expect-exit: 0
// Repeated address-of expressions must not write outside the stack frame.
fn main() -> i32 {
    var a: i32 = 7;
    var b: i32 = 9;
    var small: u8 = 1 as u8;
    let same: bool = &a == &a;
    let different: bool = &a != &b;
    if !same || !different { return 1; }
    if &a == &small { return 2; }
    let p: ptr = &a;
    if p != &a { return 3; }
    if *p != 7 { return 4; }
    return 0;
}
