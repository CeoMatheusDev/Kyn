// Fields of different types and whole-struct assignment.
// expect-exit: 21
struct State {
    total: i32,
    on: bool,
}

fn main() -> i32 {
    var e: State = State { total: 5, on: true };
    e.total = e.total * 4;
    e.on = false;
    var f: State = State { total: 1, on: true };
    f = e;
    if !f.on {
        return f.total + 1;
    }
    return 0;
}
