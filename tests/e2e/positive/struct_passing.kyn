// Struct by value in parameters: one register per field, in order.
// expect-stdout: 7
// expect-stdout: 30
// expect-stdout: 15
// expect-exit: 30
struct Point {
    x: i32,
    y: i32,
}

struct Pair {
    a: bool,
    b: i32,
}

fn sum(p: Point) -> i32 {
    return p.x + p.y;
}

fn with_bool(p: Pair, extra: i32) -> i32 {
    if p.a {
        return p.b + extra;
    }
    return extra;
}

fn main() -> i32 {
    let p: Point = Point { x: 3, y: 4 };
    print_i32(sum(p));
    print_i32(sum(Point { x: 10, y: 20 }));
    let q: Pair = Pair { a: 1 < 2, b: 7 };
    print_i32(with_bool(q, 8));
    return sum(p) + sum(Point { x: 11, y: 12 });
}
