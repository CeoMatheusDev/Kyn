// Campos `bool` e `i32` convivem no struct por valor (i1 no IR do LLVM).
// expect-stdout: 42
// expect-stdout: -1
// expect-exit: 42
struct Resultado {
    ok: bool,
    codigo: i32,
}

fn avalia(n: i32) -> Resultado {
    if n > 0 {
        return Resultado { ok: 1 < 2, codigo: 0 };
    }
    return Resultado { ok: 2 < 1, codigo: n };
}

fn codigo(r: Resultado) -> i32 {
    if r.ok {
        return r.codigo + 42;
    }
    return r.codigo;
}

fn main() -> i32 {
    let a = avalia(5);
    print_i32(codigo(a));
    let b = avalia(0 - 1);
    print_i32(codigo(b));
    return 42;
}
