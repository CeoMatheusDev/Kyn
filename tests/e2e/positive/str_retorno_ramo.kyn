// Ramificações podem devolver 'str' diferentes e o laço repete a chamada.
// expect-stdout: curto
// expect-stdout: curto
// expect-stdout: curto
// expect-stdout: grande
// expect-exit: 0
fn nome(n: i32) -> str {
    if n > 5 {
        return "grande";
    }
    return "curto";
}

fn main() -> i32 {
    var i: i32 = 1;
    while i <= 3 {
        print(nome(i));
        i = i + 1;
    }
    let g: str = nome(9);
    print(g);
    return 0;
}
