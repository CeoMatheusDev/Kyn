// i32 limits: INT_MAX, INT_MIN (where `negl` overflows but unsigned `divl`
// preserves the digits) and a 9-digit value.
// expect-exit: 3
// expect-stdout: 2147483647
// expect-stdout: -2147483648
// expect-stdout: 214748364
fn main() -> i32 {
    let max: i32 = 2147483647;
    print_i32(max);
    let min: i32 = 0 - 2147483647 - 1;
    print_i32(min);
    print_i32(214748364);
    return 3;
}
