// expect-exit: 0
// ALU results wrap at the declared width; same-width casts reinterpret bits.
fn echo(n: i8) -> i8 { return n; }

fn main() -> i32 {
    let max8: u8 = 255 as u8;
    let one8: u8 = 1 as u8;
    if max8 + one8 != (0 as u8) { return 1; }
    if max8 >> (7 as u8) != one8 { return 2; }
    if max8 / (2 as u8) != (127 as u8) { return 3; }
    if ~one8 != (254 as u8) { return 4; }
    if (max8 as i8) != ((0 - 1) as i8) { return 5; }
    if ((max8 as i8) as u8) != max8 { return 6; }

    let min8: i8 = (127 as i8) + (1 as i8);
    if min8 >= (0 as i8) { return 7; }
    if min8 / (2 as i8) != ((0 - 64) as i8) { return 8; }
    if (min8 as u8) != (128 as u8) { return 9; }
    if -min8 != echo(min8) { return 16; }
    if ~min8 != (127 as i8) { return 17; }

    let max16: u16 = 65535 as u16;
    if max16 + (1 as u16) != (0 as u16) { return 10; }
    if max16 >> (8 as u8) != (255 as u16) { return 11; }
    if max16 / (2 as u16) != (32767 as u16) { return 18; }
    if max16 % (2 as u16) != (1 as u16) { return 19; }
    let min16: i16 = (0 - 32768) as i16;
    if min16 / (2 as i16) != ((0 - 16384) as i16) { return 12; }
    if (min16 as u16) != (32768 as u16) { return 13; }
    if (((0 - 1) as i8) as u16) != max16 { return 14; }
    if (min16 as i64) != ((0 as i64) - (32768 as i64)) { return 15; }
    if -min16 != min16 { return 20; }
    return 0;
}
