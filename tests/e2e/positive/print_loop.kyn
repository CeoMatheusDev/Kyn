// `print` inside a loop: the same `str` variable printed on every iteration.
// expect-exit: 3
// expect-stdout: kyn
// expect-stdout: kyn
// expect-stdout: kyn
fn main() -> i32 {
    let msg = "kyn";
    var n: i32 = 0;
    while n < 3 {
        print(msg);
        n = n + 1;
    }
    return n;
}
