// `print_i32` dentro de laço, com valor calculado a cada iteração.
// expect-exit: 5
// expect-stdout: 10
// expect-stdout: 20
// expect-stdout: 30
// expect-stdout: 40
// expect-stdout: 50
fn main() -> i32 {
    var n: i32 = 0;
    while n < 5 {
        n = n + 1;
        print_i32(n * 10);
    }
    return n;
}
