// Struct por valor em parâmetros: um registrador por campo, na ordem.
// expect-stdout: 7
// expect-stdout: 30
// expect-stdout: 15
// expect-exit: 30
struct Ponto {
    x: i32,
    y: i32,
}

struct Par {
    a: bool,
    b: i32,
}

fn soma(p: Ponto) -> i32 {
    return p.x + p.y;
}

fn com_bool(p: Par, extra: i32) -> i32 {
    if p.a {
        return p.b + extra;
    }
    return extra;
}

fn main() -> i32 {
    let p: Ponto = Ponto { x: 3, y: 4 };
    print_i32(soma(p));
    print_i32(soma(Ponto { x: 10, y: 20 }));
    let q: Par = Par { a: 1 < 2, b: 7 };
    print_i32(com_bool(q, 8));
    return soma(p) + soma(Ponto { x: 11, y: 12 });
}
