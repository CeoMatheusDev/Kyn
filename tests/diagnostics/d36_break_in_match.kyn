enum Cor {
    Vermelho,
    Verde,
}

fn main() -> i32 {
    var i: i32 = 0;
    while i < 3 {
        let c: Cor = Cor::Verde;
        match c {
            Cor::Verde => {
                break;
            },
            _ => {
                i += 1;
            },
        }
    }
    return 0;
}
