// tests/cases/07_struct_methods.kyn — struct, métodos e função associada.
struct Vector2 {
    x: f64,
    y: f64,
}

impl Vector2 {
    fn new(x: f64, y: f64) -> Vector2 {
        return Vector2 { x: x, y: y };
    }

    fn sum(self: &Vector2) -> f64 {
        return self.x + self.y;
    }

    fn scale(self: &mut Vector2, factor: f64) -> void {
        self.x = self.x * factor;
        self.y = self.y * factor;
    }
}

fn main() -> i32 {
    var v: Vector2 = Vector2::new(1.5, 2.5);
    println(v.sum());
    v.scale(2.0);
    println(v.x);
    println(v.y);
    return 0;
}
