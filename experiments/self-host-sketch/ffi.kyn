// src/compiler/ffi.kyn — Suporte a FFI Nativa com C (extern) (v1.8.0)
import "core";

pub struct ExternFn {
    name: []u8,
    params: []Param,
    ret_type: Type,
}

pub fn parse_extern(source: []u8) Result<ExternFn, Error> {
    // Parser e Sema para chamadas de funções externas do sistema C
    // extern fn printf(fmt: [*]u8, ...) i32;
    return Ok(ExternFn { name: "printf", params: []Param {}, ret_type: Type::I32 });
}
