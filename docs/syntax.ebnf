(* Kyn — gramática sintática preliminar.
   Status: proposta ilustrativa, não implementada integralmente.
   Não substitui a gramática lexical observada em grammar.ebnf. *)

program          = { import_decl }, { declaration } ;

import_decl      = "import", qualified_name, ";" ;
qualified_name   = identifier, { ".", identifier } ;

declaration      = function_decl
                 | struct_decl
                 | enum_decl
                 | impl_decl ;

function_decl    = "fn", identifier, "(", [ parameters ], ")",
                   [ "->", type_expr ], block ;
parameters       = parameter, { ",", parameter } ;
parameter        = identifier, ":", type_expr ;

struct_decl      = "struct", identifier, "{", { field_decl }, "}" ;
field_decl       = identifier, ":", type_expr, [ "," ] ;

enum_decl        = "enum", identifier, "{", { identifier, [ "," ] }, "}" ;
impl_decl        = "impl", identifier, "{", { function_decl }, "}" ;

type_expr        = qualified_name
                 | "[", "]", type_expr
                 | "*", type_expr
                 | "&", [ "mut" ], type_expr ;

block            = "{", { statement }, "}" ;
statement        = let_decl
                 | var_decl
                 | return_stmt
                 | if_stmt
                 | while_stmt
                 | expression_stmt
                 | block ;

let_decl         = "let", identifier, ":", type_expr, "=", expression, ";" ;
var_decl         = "var", identifier, ":", type_expr, "=", expression, ";" ;
return_stmt      = "return", [ expression ], ";" ;
if_stmt          = "if", expression, block, [ "else", ( block | if_stmt ) ] ;
while_stmt       = "while", expression, block ;
expression_stmt  = expression, ";" ;

(* Expressões, precedência, literais, generics, padrões, atributos,
   visibilidade, closures e regras semânticas permanecem em aberto. *)

identifier       = letter, { letter | digit } ;
letter           = "a"…"z" | "A"…"Z" | "_" ;
digit            = "0"…"9" ;
