(* Kyn — gramática sintática do subconjunto implementado.
   Este arquivo descreve exatamente o que o parser em src/parser/parser.zig
   aceita hoje. Construções da visão de linguagem (enum, impl, generics,
   slices, ponteiros, unsafe, atributos) ainda NÃO fazem parte deste
   subconjunto; ver docs/language_reference.md e docs/status.md. *)

(* Importações vêm antes de qualquer declaração; o caminho é literal de string
   e é resolvido em relação ao diretório do arquivo que importa. *)
program          = { import_decl }, { struct_decl | function_decl }, EOF ;

import_decl      = "import", string_literal, ";" ;

(* Struct: campos com tipo explícito, vírgula final opcional.
   Restrições verificadas pela semântica: sem campos de tipo struct, sem struct
   por valor em parâmetros/retorno/argumentos. *)
struct_decl      = "struct", identifier, "{", [ field, { ",", field }, [ "," ] ], "}" ;
field            = identifier, ":", type_expr ;

function_decl    = "fn", identifier, "(", [ parameters ], ")",
                   [ "->", type_expr ], block ;

parameters       = parameter, { ",", parameter } ;
parameter        = identifier, ":", type_expr ;

(* Aceitos pela semântica: i32, bool, str, void e nomes de struct declarados. *)
type_expr        = identifier ;

block            = "{", { statement }, "}" ;

statement        = let_decl
                 | var_decl
                 | assignment
                 | field_assignment
                 | return_stmt
                 | if_stmt
                 | while_stmt
                 | block
                 | expression_stmt ;

(* O inicializador é obrigatório nesta etapa: `let x: i32;` produz
   diagnóstico 'unsupported'. *)
let_decl         = "let", identifier, [ ":", type_expr ], "=", expression, ";" ;
var_decl         = "var", identifier, [ ":", type_expr ], "=", expression, ";" ;

assignment       = identifier, "=", expression, ";" ;
field_assignment = identifier, ".", identifier, "=", expression, ";" ;
return_stmt      = "return", [ expression ], ";" ;
(* Em condições, `Nome { ... }` não é literal de struct: o `{` inicia o bloco. *)
if_stmt          = "if", condition, block, [ "else", ( block | if_stmt ) ] ;
condition        = expression ;
while_stmt       = "while", condition, block ;
expression_stmt  = expression, ";" ;

(* Precedência, do menor para o maior:
   1  ||            (bool, curto-circuito)
   2  &&            (bool, curto-circuito)
   3  == !=         (mesmo tipo, produz bool)
   4  < <= > >=     (i32, produz bool)
   5  + -           (i32, associativo à esquerda)
   6  * / %         (i32, associativo à esquerda)
   7  unários - !   (prefixo)
   8  primárias *)

expression       = logical_or ;
logical_or       = logical_and, { "||", logical_and } ;
logical_and      = equality, { "&&", equality } ;
equality         = comparison, { ( "==" | "!=" ), comparison } ;
comparison       = additive, { ( "<" | "<=" | ">" | ">=" ), additive } ;
additive         = multiplicative, { ( "+" | "-" ), multiplicative } ;
multiplicative   = unary, { ( "*" | "/" | "%" ), unary } ;
unary            = ( "-" | "!" ), unary | postfix ;

(* Acesso a campo: a base precisa ser um identificador (struct com campo
   struct ainda não existe na semântica). *)
postfix          = primary, { ".", identifier } ;

primary          = integer
                 | string_literal
                 | "true" | "false"
                 | identifier, [ "(", [ arguments ], ")" ]
                 | struct_literal
                 | "(", expression, ")" ;

(* `Nome { ... }` só é literal fora de condições de if/while, onde `{` inicia
   o bloco. Todos os campos precisam aparecer exatamente uma vez. *)
struct_literal   = identifier, "{", [ field_init, { ",", field_init }, [ "," ] ], "}" ;
field_init       = identifier, ":", expression ;

arguments        = expression, { ",", expression } ;

(* `str` é uma fatia estática (ponteiro + tamanho), não um escalar, mas
   atravessa chamadas por valor: cada parâmetro/argumento e cada retorno `str`
   ocupa dois registradores (ponteiro e tamanho). Diagnósticos: campo de struct
   de tipo `str`, `str` em aritmética, em condição e em `==`/`!=` (comparação de
   bytes ainda não existe), `main` com retorno `str`, além de expressão `str`
   sem uso. *)

(* Funções embutidas, não palavras-chave nem declarações:
   - `print(expr)` exige exatamente um argumento `str`, devolve `void` e
     escreve o texto seguido de quebra de linha;
   - `print_i32(expr)` exige exatamente um argumento `i32`, devolve `void` e
     escreve o número em decimal (com '-' quando negativo) e a quebra de linha.
   Os nomes `print` e `print_i32` são reservados para funções declaradas na
   fonte. *)
builtin_call     = ( "print" | "print_i32" ), "(", expression, ")" ;

(* Structs também atravessam chamadas por valor: cada campo escalar ocupa um
   registrador, na ordem de declaração, e o retorno usa um registrador por campo
   (até 6 campos). *)

(* Limites do backend nativo atual (documentados como pendência de projeto):
   até 6 registradores em parâmetros/argumentos por função, contando `str` como
   dois e cada campo de struct como um; sem chamadas externas; sem struct
   aninhado nem campo `str`. *)
