(* Kyn — syntactic grammar of the implemented subset.
   This file describes exactly what the parser in src/parser/parser.zig accepts
   today. Constructs from the language vision (generics, slices, unsafe
   blocks and attributes) are NOT part of this subset yet; see
   docs/language_reference.md and docs/status.md. *)

(* Imports come before any declaration; the path is a string literal and is
   resolved relative to the directory of the importing file. *)
program          = { import_decl },
                   { struct_decl | enum_decl | impl_decl | function_decl }, EOF ;

import_decl      = "import", string_literal, ";" ;

(* Struct: fields with an explicit type, optional trailing comma.
   Restrictions checked by semantics: no fields of struct type, no struct by
   value in parameters/returns/arguments. *)
struct_decl      = "struct", identifier, "{", [ field, { ",", field }, [ "," ] ], "}" ;
field            = identifier, ":", type_expr ;

(* Enum: cases in declaration order, which is also the tag value. A case may
   carry one payload, written as a type name between parentheses; only `i32` is
   supported today. The trailing comma is optional. *)
enum_decl        = "enum", identifier, "{", [ enum_case, { ",", enum_case }, [ "," ] ], "}" ;
enum_case        = identifier, [ "(", type_expr, ")" ] ;

function_decl    = "fn", identifier, "(", [ parameters ], ")",
                   [ "->", type_expr ], block ;

(* Methods of a struct or an enum: the block holds only `fn` declarations and the
   target type is resolved by semantics (a name that is not a declared struct or
   enum is diagnosed). At this stage every method declares its receiver
   explicitly as the first parameter: `self: Name`, by value. Methods live in a
   name space per type and are mangled `Type_method` in both backends. *)
impl_decl        = "impl", identifier, "{", { function_decl }, "}" ;

parameters       = parameter, { ",", parameter } ;
parameter        = identifier, ":", type_expr ;

(* Accepted by semantics: i8/i16/i32/i64, u8/u16/u32/u64, usize, bool, str,
   void, ptr, names of declared structs and names of declared enums. An enum
   crosses calls by value (tag + payload, two registers); a struct field of enum
   type is diagnosed as unsupported. `ptr` is the generic pointer annotation
   (unknown pointee); `&variable` produces a pointer whose pointee type is
   inferred from the variable. Typed pointer notation such as `ptr<i32>` is a
   semantic description, not a source-level type expression. *)
type_expr        = identifier ;

block            = "{", { statement }, "}" ;

statement        = let_decl
                 | var_decl
                 | assignment
                 | field_assignment
                 | return_stmt
                 | if_stmt
                 | while_stmt
                 | switch_stmt
                 | block
                 | expression_stmt ;

(* The initializer is mandatory at this stage: `let x: i32;` produces an
   'unsupported' diagnostic. *)
let_decl         = "let", identifier, [ ":", type_expr ], "=", expression, ";" ;
var_decl         = "var", identifier, [ ":", type_expr ], "=", expression, ";" ;

assignment       = identifier, "=", expression, ";" ;
field_assignment = identifier, ".", identifier, "=", expression, ";" ;
return_stmt      = "return", [ expression ], ";" ;
(* In conditions, `Name { ... }` is not a struct literal: the `{` starts the
   block. *)
if_stmt          = "if", condition, block, [ "else", ( block | if_stmt ) ] ;
condition        = expression ;
while_stmt       = "while", condition, block ;

(* `switch` over an enum *variable*: every arm names one case; `Case(name)`
   binds the payload of a case that declares one, a bare `Case` matches a case
   without payload. The switch must be exhaustive (all cases, or an `else` arm),
   never both: an `else` that cannot run is reported as unreachable. *)
switch_stmt      = "switch", condition, "{", { switch_arm }, "}" ;
switch_arm       = ( identifier, [ "(", identifier, ")" ] | "else" ), "=>", block ;

expression_stmt  = expression, ";" ;

(* Precedence, from loosest to tightest:
   1  ||            (bool, short-circuit)
   2  &&            (bool, short-circuit)
   3  == !=         (same type, produces bool)
   4  < <= > >=     (same integer type, produces bool)
   5  |             (bitwise OR, same integer type)
   6  ^             (bitwise XOR, same integer type)
   7  &             (bitwise AND, same integer type)
   8  << >>         (bit shifts, same integer type)
   9  + -           (same integer type, left-associative)
   10 * / %         (same integer type, left-associative)
   11 unary - ! ~   (prefix; ~ is bitwise NOT on integers)
   12 primaries *)

expression       = cast_expr ;
cast_expr        = logical_or, { "as", type_expr } ;
logical_or       = logical_and, { "||", logical_and } ;
logical_and      = equality, { "&&", equality } ;
equality         = comparison, { ( "==" | "!=" ), comparison } ;
comparison       = bitor, { ( "<" | "<=" | ">" | ">=" ), bitor } ;
bitor            = bitxor, { "|", bitxor } ;
bitxor           = bitand, { "^", bitand } ;
bitand           = shift, { "&", shift } ;
shift            = additive, { ( "<<" | ">>" ), additive } ;
additive         = multiplicative, { ( "+" | "-" ), multiplicative } ;
multiplicative   = unary, { ( "*" | "/" | "%" ), unary } ;
unary            = ( "-" | "!" | "~" | "&" | "*" ), unary | postfix ;

(* Pointer operations accepted by the parser and semantic checker include
   address-of on variables, dereference, pointer arithmetic/comparison and
   field access through a pointer to a known struct. The native x86-64 backend
   lowers these operations; the LLVM backend currently rejects address-of and
   dereference during emission. *)

(* Dotted postfix. `Name.Case(...)` is an enum constructor; `value.method(...)`
   is a method call whose receiver (the base) is passed as argument 1; a dotted
   name without call is a field access. The base of a field access must be a
   variable (or a call returning a struct); a struct with a struct field does not
   exist in semantics yet. *)
postfix          = primary, { ".", identifier, [ "(", [ arguments ], ")" ] } ;

primary          = integer
                 | string_literal
                 | "true" | "false"
                 | identifier, [ "(", [ arguments ], ")" ]
                 | struct_literal
                 | "(", expression, ")" ;

(* `Name { ... }` is only a literal outside if/while conditions, where `{`
   starts the block. Every field must appear exactly once. *)
struct_literal   = identifier, "{", [ field_init, { ",", field_init }, [ "," ] ], "}" ;
field_init       = identifier, ":", expression ;

arguments        = expression, { ",", expression } ;

(* `str` is a static slice (pointer + length), not a scalar, but it crosses
   calls by value: every `str` parameter/argument and every `str` return takes
   two registers (pointer and length). Diagnostics: struct field of type `str`,
   `str` in arithmetic, in conditions and in `==`/`!=` (byte comparison does not
   exist yet), `main` returning `str`, plus an unused `str` expression. *)

(* Builtin functions, neither keywords nor declarations:
   - `print(expr)` requires exactly one `str` argument, returns `void` and
     writes the text followed by a line break;
   - `print_i32(expr)` requires exactly one `i32` argument, returns `void` and
     writes the number in decimal (with '-' when negative) plus the line break.
   The names `print` and `print_i32` are reserved for functions declared in the
   source. *)
builtin_call     = ( "print" | "print_i32" ), "(", expression, ")" ;

(* Structs also cross calls by value: each scalar field takes one register, in
   declaration order, and the return uses one register per field (up to 6
   fields). *)

(* Limits of the current native backend (documented as a design pending item):
   up to 6 parameter/argument registers per function, counting `str` as two and
   each struct field as one; no external calls; no nested struct or `str`
   field. *)

(* Enum values carry a tag (the case index in declaration order) and one
   payload slot, and cross calls as a pair (tag, payload). They take part in no
   operator (`==`, arithmetic and conditions are diagnosed) and are consumed
   only by `switch`, which reads the tag from the variable slots. A case without
   payload is written `Color.Red`; a case with payload is written
   `Shape.Circle(5)`. *)
