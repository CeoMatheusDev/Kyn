(* Kyn — implemented lexical grammar.
   Mirrors src/lexer/lexer.zig: tokens, keywords and operators.
   Whitespace and line comments are discarded by the lexer. *)

program    = { token } ;

token      = identifier
           | integer
           | string_literal
           | keyword
           | operator
           | punctuation ;

identifier = ( letter | "_" ), { letter | digit | "_" } ;
integer    = digit, { digit } ;   (* value converted to i64 by the parser *)

(* String literal: content between double quotes, no escapes and no line
   break. The token keeps the text without the quotes; an open literal becomes
   "string_unterminated" and the parser reports an error with the position. It
   is used as an `import` path and as an expression of type `str` (`print`
   argument). *)
string_literal = '"', { any_char - ( '"' | "\n" | "\r" ) }, '"' ;

keyword    = "fn" | "let" | "var" | "return"
           | "if" | "else" | "while" | "switch"
           | "import" | "struct" | "enum" | "impl" | "true" | "false" ;

(* "=>" (fat arrow) separates a switch case from its body; "->" is only the
   return arrow of a function signature. *)
operator   = "->" | "=>"
           | "==" | "!=" | "<" | "<=" | ">" | ">="
           | "=" | "+" | "-" | "*" | "/" | "%" | "!"
           | "&&" | "||" ;

punctuation = "(" | ")" | "{" | "}" | ":" | ";" | "," | "." ;

whitespace = " " | "\t" | "\r" | "\n" ;          (* discarded *)
comment    = "//", { any_char - "\n" } ;         (* discarded *)

(* A character outside the rules above produces the "invalid" token, which the
   parser turns into a diagnostic with the exact position. Isolated '&' and '|'
   are invalid: only '&&' and '||' exist. *)

letter     = "a"…"z" | "A"…"Z" ;
digit      = "0"…"9" ;

(* The input is treated as ASCII bytes. Non-ASCII bytes are "invalid". *)
