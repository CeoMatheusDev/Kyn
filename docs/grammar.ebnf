(* Kyn — gramática lexical implementada.
   Reflete src/lexer/lexer.zig: tokens, palavras-chave e operadores.
   Espaços em branco e comentários de linha são descartados pelo lexer. *)

program    = { token } ;

token      = identifier
           | integer
           | keyword
           | operator
           | punctuation ;

identifier = ( letter | "_" ), { letter | digit | "_" } ;
integer    = digit, { digit } ;   (* valor convertido para i64 pelo parser *)

keyword    = "fn" | "let" | "var" | "return"
           | "if" | "else" | "while"
           | "true" | "false" ;

operator   = "->"
           | "==" | "!=" | "<" | "<=" | ">" | ">="
           | "=" | "+" | "-" | "*" | "/" | "%" | "!"
           | "&&" | "||" ;

punctuation = "(" | ")" | "{" | "}" | ":" | ";" | "," ;

whitespace = " " | "\t" | "\r" | "\n" ;          (* descartado *)
comment    = "//", { any_char - "\n" } ;         (* descartado *)

(* Um caractere fora das regras acima produz o token "invalid", que o parser
   converte em diagnóstico com a posição exata. '&' e '|' isolados são
   inválidos: apenas '&&' e '||' existem. *)

letter     = "a"…"z" | "A"…"Z" ;
digit      = "0"…"9" ;

(* A entrada é tratada como bytes ASCII. Bytes não-ASCII são "invalid". *)
