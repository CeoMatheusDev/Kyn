// std/core/atomics.kyn — low-level atomic primitives (v1.9.0)
import "core";

pub fn atomic_load(ptr: *u32) u32 {
    // Memory barrier + atomic load
    return *ptr;
}

pub fn atomic_store(ptr: *u32, value: u32) {
    // Memory barrier + atomic store
    *ptr = value;
}

pub fn memory_barrier() {
    // Full memory barrier
}
