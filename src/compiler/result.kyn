// src/compiler/result.kyn — Native Result<T, E> with ? propagation (v2.1.0-beta.1)
import "core";

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

pub fn propagate<T, E>(r: Result<T, E>) -> T {
    match r {
        Ok(val) => val,
        Err(e) => return Err(e),
    }
}

// ? operator implemented through a macro/comptime
// let x = foo()?; // propagates the error automatically
