// src/compiler/diagnostics.kyn — Rust/Zig-style error reporter
import "span.kyn";

pub enum ErrorCode {
    E0001, // Invalid syntax
    E0002, // Incompatible types
    E0003, // Undeclared variable
}

pub struct Diagnostic {
    code: ErrorCode,
    message: []u8,
    span: Span,
    help: []u8,
}

pub fn report(d: Diagnostic) {
    // Format and print to the terminal with ^~~~ markers
    // Example:
    // error[E0002]: type mismatch detected
    //  --> file.kyn:4:17
    //   |
    // 4 | let x: i32 = "text";
    //   |        ---   ^^^^^^^ expected 'i32', found '[]u8'
    //   |        |
    //   |        type declared here
    //   |
    // help: change the value...
    _ = d;
}
