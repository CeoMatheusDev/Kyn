// src/compiler/mutability.kyn — Strict mutability checking (v1.6.0)
import "core";

pub fn check_mutability(var_decl: VarDecl) Result<(), Error> {
    // Rejects modifications of immutable variables
    // Guarantees valid ref mut references
    if !var_decl.mutable and var_decl.assigned {
        return Err(Error::ImmutableModification);
    }
    return Ok(());
}
