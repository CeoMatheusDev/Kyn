// src/compiler/ffi.kyn — Native FFI support for C (extern) (v1.8.0)
import "core";

pub struct ExternFn {
    name: []u8,
    params: []Param,
    ret_type: Type,
}

pub fn parse_extern(source: []u8) Result<ExternFn, Error> {
    // Parser and sema for calls to external C system functions
    // extern fn printf(fmt: [*]u8, ...) i32;
    return Ok(ExternFn { name: "printf", params: []Param {}, ret_type: Type::I32 });
}
