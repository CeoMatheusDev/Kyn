// src/compiler/span.kyn — Source location span (Diagnostics)
pub struct Span {
    file_path: []u8,
    line: usize,
    column: usize,
    length: usize,
}

pub fn span_new(file_path: []u8, line: usize, column: usize, length: usize) Span {
    return Span { file_path: file_path, line: line, column: column, length: length };
}
